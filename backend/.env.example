# ============================================================
# HomeServer Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# IMPORTANT: Never commit the .env file to version control!

# REQUIRED — JWT signing secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# The server will REFUSE TO START if this is missing or weak.
SECRET_KEY=

# Where uploaded files are permanently stored (HDD / large drive)
STORAGE_PATH=/data/uploads

# Fast temp directory for upload buffering (SSD recommended)
TEMP_PATH=/tmp/homeserver

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./homeserver.db

# ============================================================
# CORS — Allowed Origins
# ============================================================
# Comma-separated list of allowed CORS origins.
# Add ALL origins that need to access this backend.
#
# For LOCAL-ONLY use:
#   ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
#
# For VERCEL + TAILSCALE FUNNEL deployment, add your Vercel domain
# AND the Funnel URL:
#   ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://my-homeserver.vercel.app,https://aswin-laptop.tail1234.ts.net
#
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Maximum upload file size in bytes (default: 50 GB)
MAX_UPLOAD_SIZE=53687091200

# ============================================================
# Admin & Quotas
# ============================================================

# Default storage quota for new users in bytes (default: 5 GB)
DEFAULT_STORAGE_QUOTA=5368709120

# Auto-promote the first registered user to admin (true/false)
AUTO_ADMIN_FIRST_USER=true

# Optional: restrict admin panel API access to specific IPs (comma-separated)
# Leave empty to allow all authenticated admins from any IP.
# Example: ADMIN_ALLOWED_IPS=127.0.0.1,100.100.100.100
ADMIN_ALLOWED_IPS=

# ============================================================
# Email / Forgot Password (Optional)
# ============================================================
# If omitted, password reset links are only printed to the server console.
# If provided, the server will attempt to email password reset links.
FRONTEND_URL=http://localhost:5173
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=HomeServer <noreply@yourdomain.com>

# ============================================================
# Admin Promotion CLI
# ============================================================
# To manually promote an existing user to admin:
#   cd backend && source ../env/bin/activate
#   python promote_admin.py <username>
